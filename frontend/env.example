# Copy this file to ".env" (with the dot) in the same folder, then fill in the key.
# ".env" is gitignored. Never commit it, never put the key in frontend code.

# Sandbox key. Not included here on purpose — ask William for it, he'll send
# it to you privately (e.g. WhatsApp). No quotes, no spaces. Never commit it
# or post it anywhere public.
BMONI_API_KEY=

# Sandbox only. The code refuses any other host.
BMONI_BASE_URL=https://embedded-dev.bmoni.com

# Optional. On the SHARED sandbox key, both built-in test personas' phone numbers are
# already registered by other teams, so BMONI returns 409 and the merchant user can't be
# created. KYC verifies the BVN + name (not the phone), so set a spare made-up phone here
# to let provisioning succeed. Leave empty to use the persona's own phone (fine on a key
# whose personas are free). Example: +2348000009321
BMONI_MERCHANT_PHONE=

# Optional. Filled in by: npx tsx --env-file=.env scripts/register-webhook.ts
# (needs a public https URL; the shared key already has a webhook owned by BMONI, so leave this empty).
BMONI_WEBHOOK_SECRET=

# Protects /api/jobs/daily (expiry + reminders). Make up your own value.
CRON_SECRET=change-me

# Only needed for real webhooks (a public https URL, e.g. ngrok).
APP_PUBLIC_URL=http://localhost:3000

# Demo only: if BMONI cannot issue a real virtual account, show a clearly labelled
# placeholder so the demo still runs. Ignored in production.
DEMO_FALLBACK_ACCOUNT=true

# Real auth + data backend (Felix's Flask app). Set this to enable real email/password auth
# via Flask (register/login/logout/me over a session cookie) and client-side route gating.
# Leave blank to run the mock "Ada" demo (no auth, no gating). Never hardcode this in code.
# Local example: http://127.0.0.1:5000
NEXT_PUBLIC_API_BASE=

# Supabase email/password auth — kept ONLY as the demo-mode fallback (used when
# NEXT_PUBLIC_API_BASE above is blank). Public (browser-safe) values only — never a
# service-role key. Leave both blank to run the mock "Ada" demo. Find them in your Supabase
# project: Settings → API (Project URL + anon public key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
